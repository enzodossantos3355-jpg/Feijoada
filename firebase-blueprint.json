{
  "entities": {
    "User": {
      "title": "User",
      "description": "Perfil e configurações do usuário do restaurante",
      "type": "object",
      "properties": {
        "user_id": { "type": "string", "maxLength": 128 },
        "email": { "type": "string", "format": "email", "maxLength": 256 },
        "name": { "type": "string", "maxLength": 120 },
        "role": { "type": "string", "enum": ["admin", "operator", "kitchen"] },
        "day_state": { "type": "string", "enum": ["open", "closed"] },
        "created_at": { "type": "string" }
      },
      "required": ["user_id", "email", "name"]
    },
    "Product": {
      "title": "Product",
      "description": "Prato ou item vendido pela marmitaria",
      "type": "object",
      "properties": {
        "product_id": { "type": "string", "maxLength": 128 },
        "user_id": { "type": "string", "maxLength": 128 },
        "name": { "type": "string", "maxLength": 100 },
        "description": { "type": "string", "maxLength": 500 },
        "price": { "type": "number" },
        "category": { "type": "string", "maxLength": 60 },
        "active": { "type": "boolean" }
      },
      "required": ["product_id", "user_id", "name", "price"]
    },
    "Order": {
      "title": "Order",
      "description": "Pedido de marmita",
      "type": "object",
      "properties": {
        "order_id": { "type": "string", "maxLength": 128 },
        "user_id": { "type": "string", "maxLength": 128 },
        "customer_name": { "type": "string", "maxLength": 100 },
        "total": { "type": "number" },
        "status": { "type": "string" }
      },
      "required": ["order_id", "user_id", "customer_name", "total", "status"]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": "User",
      "description": "Documentos de conta e perfil dos proprietários e operadores"
    },
    "/users/{userId}/products/{productId}": {
      "schema": "Product",
      "description": "Catálogo de marmitas e produtos pertencentes à marmitaria"
    },
    "/users/{userId}/orders/{orderId}": {
      "schema": "Order",
      "description": "Pedidos recebidos pelo balcão ou WhatsApp da marmitaria"
    }
  }
}
